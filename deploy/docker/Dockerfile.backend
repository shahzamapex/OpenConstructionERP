# OpenConstructionERP — Backend API Container for Render / Cloud Deployments
#
# Decoupled deployment: Python FastAPI backend on Render, React SPA frontend on Vercel.
# Builds the backend without invoking Node/Vite build, fitting comfortably within
# Render starter builder memory limits.

ARG OE_EXTRAS=server,semantic-clients

FROM python:3.12-slim AS backend

# libpq for PostgreSQL support and curl for healthcheck.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq-dev curl \
    && rm -rf /var/lib/apt/lists/*

# Non-root service user.
RUN groupadd -r oe && useradd -r -g oe -d /app -s /sbin/nologin oe

WORKDIR /app

# Backend package files before install.
COPY backend/ backend/

# Force-include external data and partner packs required by hatchling build
COPY data/match/ data/match/
COPY packs/aus/src/ packs/aus/src/
COPY packs/austria-at/src/ packs/austria-at/src/
COPY packs/batimatech-ca/src/ packs/batimatech-ca/src/
COPY packs/belgium-be/src/ packs/belgium-be/src/
COPY packs/bimhessen-de/src/ packs/bimhessen-de/src/
COPY packs/brazil-sinapi/src/ packs/brazil-sinapi/src/
COPY packs/canada-ca/src/ packs/canada-ca/src/
COPY packs/china-gbt50500/src/ packs/china-gbt50500/src/
COPY packs/croatia-hr/src/ packs/croatia-hr/src/
COPY packs/czechia-cz/src/ packs/czechia-cz/src/
COPY packs/denmark-dk/src/ packs/denmark-dk/src/
COPY packs/doker-formwork/src/ packs/doker-formwork/src/
COPY packs/egypt-eg/src/ packs/egypt-eg/src/
COPY packs/eleven-areas-framework/src/ packs/eleven-areas-framework/src/
COPY packs/france-fr/src/ packs/france-fr/src/
COPY packs/germany-de/src/ packs/germany-de/src/
COPY packs/greece-gr/src/ packs/greece-gr/src/
COPY packs/hungary-hu/src/ packs/hungary-hu/src/
COPY packs/india-cpwd/src/ packs/india-cpwd/src/
COPY packs/indonesia-id/src/ packs/indonesia-id/src/
COPY packs/ireland-ie/src/ packs/ireland-ie/src/
COPY packs/italy-it/src/ packs/italy-it/src/
COPY packs/japan-jp/src/ packs/japan-jp/src/
COPY packs/korea-kr/src/ packs/korea-kr/src/
COPY packs/mexico-mx/src/ packs/mexico-mx/src/
COPY packs/modular-prefab/src/ packs/modular-prefab/src/
COPY packs/netherlands-nl/src/ packs/netherlands-nl/src/
COPY packs/nigeria-ng/src/ packs/nigeria-ng/src/
COPY packs/norway-no/src/ packs/norway-no/src/
COPY packs/nzs/src/ packs/nzs/src/
COPY packs/pakistan-pk/src/ packs/pakistan-pk/src/
COPY packs/poland-pl/src/ packs/poland-pl/src/
COPY packs/portugal-pt/src/ packs/portugal-pt/src/
COPY packs/renewables-epc/src/ packs/renewables-epc/src/
COPY packs/retail-grocery-dach/src/ packs/retail-grocery-dach/src/
COPY packs/romania-ro/src/ packs/romania-ro/src/
COPY packs/russia-gesn/src/ packs/russia-gesn/src/
COPY packs/saudi-vision2030/src/ packs/saudi-vision2030/src/
COPY packs/singapore-sg/src/ packs/singapore-sg/src/
COPY packs/south-africa/src/ packs/south-africa/src/
COPY packs/spain-es/src/ packs/spain-es/src/
COPY packs/sweden-se/src/ packs/sweden-se/src/
COPY packs/switzerland-ch/src/ packs/switzerland-ch/src/
COPY packs/turkey-tr/src/ packs/turkey-tr/src/
COPY packs/turkey-tr-mep/src/ packs/turkey-tr-mep/src/
COPY packs/uae-ae/src/ packs/uae-ae/src/
COPY packs/uk-jct/src/ packs/uk-jct/src/
COPY packs/ukraine-ua/src/ packs/ukraine-ua/src/
COPY packs/us-california/src/ packs/us-california/src/
COPY packs/us-costdata/src/ packs/us-costdata/src/
COPY packs/us-texas/src/ packs/us-texas/src/

# Empty frontend placeholder so hatchling resolves force-include without error
RUN mkdir -p /app/frontend/dist && touch /app/frontend/dist/.placeholder

# Persistent data volume for BIM geometry and vectors
RUN mkdir -p /data && chown oe:oe /data

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    OE_DATA_DIR=/data

ARG OE_EXTRAS
RUN pip install --no-cache-dir "./backend[${OE_EXTRAS}]"

# Data catalogs for seeding and enrichment
COPY data/ data/

# Entrypoint script
COPY --chmod=0755 deploy/docker/entrypoint.sh /app/entrypoint.sh

RUN chown -R oe:oe /app
USER oe

ENV SERVE_FRONTEND=false \
    VECTOR_BACKEND=lancedb \
    VECTOR_DATA_DIR=/data/vectors \
    APP_ENV=production \
    APP_DEBUG=false

EXPOSE 8080
VOLUME ["/data"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8080}/api/health || exit 1

ENTRYPOINT ["/app/entrypoint.sh"]
