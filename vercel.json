{
  "outputDirectory": "frontend/dist",
  "buildCommand": "echo Frontend assets ready",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://openconstruction-backend.onrender.com/api/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
